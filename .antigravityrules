import { useDialog } from '@turbo-project/ui/headless'
import { DialogOverlay, DialogContent } from '@turbo-project/ui/primitives'

function CustomDialog() {
  const { isOpen, open, close } = useDialog()

  return (
    <>
      <button onClick={open}>Open</button>
      {isOpen && (
        <DialogOverlay onClick={close}>
          <DialogContent>{/* 커스텀 내용 */}</DialogContent>
        </DialogOverlay>
      )}
    </>
  )
}
```

### 미리 조합된 컴포넌트 사용 (Components)

```tsx
import { Dialog } from '@turbo-project/ui/components'

function Page() {
  return (
    <Dialog.Root>
      <Dialog.Trigger>
        <button>Open</button>
      </Dialog.Trigger>
      <Dialog.Content>
        <Dialog.Title>제목</Dialog.Title>
        <p>내용</p>
      </Dialog.Content>
    </Dialog.Root>
  )
}
```

